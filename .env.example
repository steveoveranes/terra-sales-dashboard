# ---- Terra Sales Dashboard configuration ----
# Copy this file to ".env" and fill in your values.

# HubSpot private app token (server-side only, never sent to the browser).
# You can reuse your existing HubSpot token.
HUBSPOT_TOKEN=pat-na1-xxxxxxxxxxxxxxxx

# Port the app listens on (open http://localhost:8080 after starting).
PORT=8080

# Data store. Leave EMPTY for local dev → a zero-config JSON file in ./data.
# Set to a PostgreSQL connection string to use Postgres (production: a dedicated
# database on the shared Postgres server). The app creates its own tables on start.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/terra_sales_dashboard
DATABASE_URL=

# Years to synchronise from HubSpot (comma separated). Phase 1: 2026 only.
SYNC_YEARS=2026

# HubSpot pipeline IDs to include (comma separated).
PIPELINE_IDS=default,11366959,148764192,691243093,2372383,4371268

# Deal-stage labels to always exclude (comma separated, case-insensitive).
EXCLUDED_STAGE_LABELS=suspect,closed lost

# Auto-sync schedule as a cron expression. Default: every hour.
SYNC_CRON=0 * * * *

# Set to 1 to load a small sample dataset instead of calling HubSpot
# (handy for a first look without a token). Set to 0 for real data.
USE_MOCK=1

# ---- Ideas & feedback follow-up e-mail (the 🐛 bubble, phase 3) ----
# SECRETS live here only — never in the Settings screen. Non-secret settings
# (owner e-mail, thresholds, schedule) are editable in-app under ⚙ Settings and
# stored in the database; the values below are just the fallback defaults.
#
# Uses the same route TerraFlow uses: Gmail SMTP with a Gmail *app-password*
# (Google account → Security → 2-step verification → App passwords). Reuse the
# same credentials TerraFlow's EMAIL_HOST_USER / EMAIL_HOST_PASSWORD use.
# Leave SMTP_USER/SMTP_PASS empty to run in console mode (logs mail, sends nothing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# From-address on outgoing mail. With Gmail this must equal SMTP_USER.
MAIL_FROM=
# Where owner reminders go, and how e-mail deep-links back into the dashboard.
OWNER_EMAIL=sverver@terra-inspectioneering.com
OWNER_NAME=Steven
APP_BASE_URL=http://localhost:8080
# Follow-up scheduler (cadence is read at startup; thresholds/toggle are live).
FOLLOWUP_ENABLED=1
FOLLOWUP_CRON=0 8 * * 1-5
OWNER_REMINDER_WORKDAYS=3
OWNER_REMINDER_REPEAT_DAYS=7
OWNER_ESCALATE_WORKDAYS=10
USER_UPDATE_REPEAT_DAYS=7
