# ---- Terra Sales Dashboard configuration ----
# Copy this file to ".env" and fill in your values.

# HubSpot private app token (server-side only, never sent to the browser).
# You can reuse your existing HubSpot token.
HUBSPOT_TOKEN=pat-na1-xxxxxxxxxxxxxxxx

# Port the app listens on (open http://localhost:8080 after starting).
PORT=8080

# Years to synchronise from HubSpot (comma separated). Phase 1: 2026 only.
SYNC_YEARS=2026

# HubSpot pipeline IDs to include (comma separated).
PIPELINE_IDS=default,11366959,148764192,691243093,2372383,4371268

# Deal-stage labels to always exclude (comma separated, case-insensitive).
EXCLUDED_STAGE_LABELS=suspect,closed lost

# Auto-sync schedule as a cron expression. Default: every hour.
SYNC_CRON=0 * * * *

# Set to 1 to load a small sample dataset instead of calling HubSpot
# (handy for a first look without a token). Set to 0 for real data.
USE_MOCK=1
